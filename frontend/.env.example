# Optional override. Use localhost for web/iOS Simulator, 10.0.2.2 for an
# Android emulator, or the development PC's LAN IP for a physical device.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Public client configuration for Supabase Auth. These values identify the
# project; database protection still depends on RLS and least-privilege grants.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
