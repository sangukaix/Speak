# Backend-only integrations. Keep secret keys out of frontend EXPO_PUBLIC_*
# variables and out of version control.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Keep one active asymmetric algorithm; list both only during a planned key rotation.
SUPABASE_JWT_ALGORITHMS=ES256

# Local application configuration
BACKEND_APP_NAME=Speak AI API
BACKEND_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
