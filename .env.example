# Backend-only secrets. Never expose these through EXPO_PUBLIC_* variables.
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local application configuration
BACKEND_APP_NAME=Speak AI API
BACKEND_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Public frontend configuration (copy to frontend/.env when needed)
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
